# Reference settings only; .env is not loaded automatically. Use CLI options.
CLOUDSYNC_SOURCE_DIR=C:/path/to/source
CLOUDSYNC_LOCAL_DESTINATION=C:/path/to/destination
CLOUDSYNC_DATABASE_PATH=data/cloudsync.sqlite3
CLOUDSYNC_CHUNK_SIZE_BYTES=1048576
CLOUDSYNC_STORAGE_BACKEND=local
AWS_DEFAULT_REGION=ap-southeast-2
CLOUDSYNC_S3_BUCKET=cloudsync-dev-2026-431223004207-ap-southeast-2-an
# Use the standard AWS credential provider chain; do not commit credentials.
AWS_PROFILE=cloudsync-dev
